{
  "name": "thinking-in-systems",
  "version": "1.0.0",
  "description": "A static blog built with Hugo and the Blowfish theme",
  "scripts": {
    "build": "hugo --minify",
    "serve": "hugo server -D",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:yml": "yamllint .",
    "lint:summary": "bash scripts/check-summaries.sh",
    "lint:tags": "bash scripts/check-tags.sh",
    "test": "hugo test",
    "prepare": "husky"
  },
  "keywords": [
    "hugo",
    "blog",
    "blowfish-theme"
  ],
  "author": "Thomas Wölfle",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2",
    "*.{yml,yaml}": "yamllint"
  }
}
