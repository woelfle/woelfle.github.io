{
  "name": "hugo-loveit-blog",
  "version": "1.0.0",
  "description": "A static blog built with Hugo and the LoveIt theme",
  "scripts": {
    "build": "hugo --minify",
    "serve": "hugo server --disableFastRender -D",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:yml": "yamllint .",
    "test": "hugo test",
    "prepare": "husky"
  },
  "keywords": [
    "hugo",
    "blog",
    "loveit-theme"
  ],
  "author": "Thomas Wölfle",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2",
    "*.{yml,yaml}": "yamllint"
  }
}
