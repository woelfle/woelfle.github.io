{
  // Respect .gitignore (excludes node_modules/, public/, ...) when enumerating files
  "gitignore": true,
  "config": {
    // Line length: not enforced for prose-heavy blog content
    "MD013": false,
    // Allow headings ending in '?' which are common in blog titles
    "MD026": {
      "punctuation": ".,;:!。，；：！"
    },
    // Hugo content often starts with prose after the front matter block
    "MD041": false,
    // Enforce heading hierarchy: no skipping levels (e.g. h1 -> h3).
    // Hugo renders the front-matter title as h1, so post content should
    // start with h2 (##) and descend incrementally.
    "MD001": {
      "front_matter_title": false
    },
    // Layout templates use Hugo/Go syntax, not pure Markdown
    "MD037": false,
    "MD033": false
  }
}
