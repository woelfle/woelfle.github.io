{
    "name": "opencode-devcontainer",    
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "containerEnv": {
      /**
       * The ZscalerRootCertificate has to be made available to the VSCode process inside of
       * the Devcontainer. Otherwise it is not possible to install plugins. The base image
       * this Devcontainer is built upon already has the ZscalerRootCertificate installed.
       */
      // "NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/ZscalerRootCertificate.crt"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "esbenp.prettier-vscode",
                "sst-dev.opencode",
                "budparr.language-hugo-vscode",
                "eliostruyf.vscode-front-matter"
            ]
        }
    },
    "mounts": [
        "source=/home/woelfle/work/code/woelfle/ai-tooling/tools/opencode/storage/config,target=/root/.config/opencode,type=bind,consistency=cached",
        "source=/home/woelfle/work/code/woelfle/ai-tooling/tools/opencode/storage/share,target=/root/.local/share/opencode,type=bind,consistency=cached",
        "source=/home/woelfle/work/code/woelfle/ai-tooling/skills,target=/root/.claude/skills,type=bind,consistency=cached",
        "source=/home/woelfle/work/code/woelfle/ai-tooling/commands,target=/root/.config/opencode/commands,type=bind,consistency=cached"
    ]
}
