---
# yamllint configuration for this Hugo blog
# Auto-discovered when running `yamllint .`

extends: default

ignore:
  - node_modules/
  - public/
  - resources/
  - .git/
  - .opencode-mem/
  # Deploy Now-generated workflow files (contain IONOS boilerplate)
  - .github/workflows/deploy-to-ionos.yaml
  - .github/workflows/website-thomas.woelfle-build.yaml
  - .github/workflows/website-thomas.woelfle-orchestration.yaml

rules:
  # Allow longer lines (comments in workflow files, long URLs)
  line-length:
    max: 120
  # GitHub Actions workflow files use `on:` as a trigger key
  truthy:
    check-keys: false
